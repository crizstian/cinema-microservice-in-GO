{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cinema-values-schema",
  "title": "Cinema Platform Values Schema",
  "description": "Schema for validating Kubernetes deployment values",
  "type": "object",
  "required": ["serviceName", "environment", "namespace", "database"],
  "properties": {
    "serviceName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Service name (lowercase, alphanumeric with hyphens)"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Version tag for the service"
    },
    "environment": {
      "type": "string",
      "enum": ["dev", "staging", "prod"],
      "description": "Deployment environment"
    },
    "namespace": {
      "type": "string",
      "pattern": "^cinema-(dev|staging|prod)$",
      "description": "Kubernetes namespace"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "description": "Service port"
    },
    "dbName": {
      "type": "string",
      "minLength": 1,
      "description": "Database name"
    },
    "database": {
      "type": "object",
      "required": ["servers", "replica", "user", "password"],
      "properties": {
        "servers": {
          "type": "string",
          "minLength": 1,
          "description": "MongoDB server(s) connection string"
        },
        "replica": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$",
          "description": "MongoDB replica set name (required, cannot be empty)",
          "errorMessage": "database.replica is required and cannot be empty. Use 'rs0' for standard replica set."
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "description": "Database username"
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "description": "Database password"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+m?$" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string", "pattern": "^[0-9]+m?$" },
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "cpuThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
        "memoryThreshold": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        }
      }
    },
    "services": {
      "type": "object",
      "description": "Service discovery URLs",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https?://"
      }
    }
  }
}
