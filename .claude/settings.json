{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(go mod tidy:*)",
      "Bash(GOPATH=/workspace/.go GOMODCACHE=/workspace/.go/pkg/mod go mod tidy:*)",
      "Bash(GOPATH=/tmp/go-cache GOMODCACHE=/tmp/go-cache/pkg/mod go mod tidy:*)",
      "Bash(GOPATH=/tmp/go-cache GOMODCACHE=/tmp/go-cache/pkg/mod go test:*)",
      "Bash(GOPATH=/tmp/go-cache GOMODCACHE=/tmp/go-cache/pkg/mod go list:*)",
      "Bash(GOPATH=/tmp/go-cache GOMODCACHE=/tmp/go-cache/pkg/mod go build:*)",
      "Bash(GOPATH=/tmp/go-cache GOMODCACHE=/tmp/go-cache/pkg/mod go work sync:*)",
      "Bash(done)",
      "Bash(chmod:*)",
      "Bash(docker-compose config:*)",
      "Bash(bash -n:*)",
      "Bash(bash:*)",
      "Bash(SERVICE=booking-service VERSION=v1.0.0-test bash -x /workspace/scripts/build-image.sh)",
      "Bash(docker-compose:*)",
      "Bash(python3:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(go work:*)",
      "Bash(test:*)",
      "Bash(go build ./...)",
      "Bash(go build:*)",
      "Bash(go list:*)",
      "Bash(go test:*)"
    ]
  },
  "mcpServers": {
    "harness": {
      "command": "harness-mcp-v2",
      "args": [],
      "env": {
        "HARNESS_API_KEY": "${containerEnv:HARNESS_API_KEY}",
        "HARNESS_DEFAULT_ORG_ID": "${containerEnv:HARNESS_DEFAULT_ORG_ID}",
        "HARNESS_DEFAULT_PROJECT_ID": "${containerEnv:HARNESS_DEFAULT_PROJECT_ID}",
        "HARNESS_BASE_URL": "${containerEnv:HARNESS_BASE_URL}",
        "HARNESS_TOOLSETS": "${containerEnv:HARNESS_TOOLSETS}",
        "HARNESS_SKIP_ELICITATION": "false"
      }
    }
  },
  "model": "claude-opus-4-5",
  "allowedTools": [
    "Bash",
    "Read",
    "Write",
    "Edit",
    "Glob",
    "Grep",
    "mcp__harness__harness_list",
    "mcp__harness__harness_get",
    "mcp__harness__harness_diagnose",
    "mcp__harness__harness_status",
    "mcp__harness__harness_execute"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/watch-pipeline.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify-pipeline-status.sh",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
