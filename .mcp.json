{
  "mcpServers": {
    "harness": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "harness-mcp-v2"],
      "env": {
        "HARNESS_API_KEY": "${HARNESS_API_KEY}",
        "HARNESS_ACCOUNT_ID": "${HARNESS_ACCOUNT_ID}",
        "HARNESS_ORG": "${HARNESS_ORG}",
        "HARNESS_PROJECT": "${HARNESS_PROJECT}",
        "HARNESS_BASE_URL": "${HARNESS_BASE_URL}",
        "HARNESS_TOOLSETS": "${HARNESS_TOOLSETS}",
        "HARNESS_SKIP_ELICITATION": "${HARNESS_SKIP_ELICITATION:-false}",
        "HARNESS_PIPELINE_VERSION": "${HARNESS_PIPELINE_VERSION:-0}",
        "HARNESS_API_TIMEOUT_MS": "${HARNESS_API_TIMEOUT_MS:-30000}",
        "LOG_LEVEL": "${LOG_LEVEL:-info}"
      }
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "GH_TOKEN": "${GH_TOKEN}"
      }
    },
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-kubernetes"],
      "env": {
        "KUBECONFIG": "${KUBECONFIG:-/home/devuser/.kube/config}"
      }
    }
  }
}
